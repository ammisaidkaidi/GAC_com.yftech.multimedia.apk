<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2"
    android:versionName="1.0.1"
    android:compileSdkVersion="28"
    android:compileSdkVersionCodename="9"
    package="com.yftech.multimedia"
    platformBuildVersionCode="2"
    platformBuildVersionName="1.0.1">
    <uses-sdk
        android:minSdkVersion="27"
        android:targetSdkVersion="28"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="com.yftech.persmission.CAR_READ_STATUS_INFOR"/>
    <uses-permission android:name="com.yftech.persmission.READ_SYSTEM_STATUS_INFOR"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="com.yftech.permission.service.main.audio"/>
    <uses-permission android:name="com.yftech.permission.service.car"/>
    <uses-permission android:name="com.yftech.permission.test"/>
    <uses-permission android:name="com.yftech.permission.service.main.screen"/>
    <uses-permission android:name="com.yftech.permission.service.main.input"/>
    <uses-permission android:name="com.yftech.permission.service.main.audio.effect"/>
    <uses-permission android:name="com.yftech.permission.service.upgrade.upgrade"/>
    <uses-permission android:name="com.yftech.permission.media.service"/>
    <uses-permission android:name="com.yftech.permission.service.bluetooth"/>
    <uses-permission android:name="com.yftech.permission.service.transfer.phonelink"/>
    <uses-permission android:name="com.yftech.permission.service.vehicle.COMMON"/>
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application
        android:theme="@style/custom_theme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:name="com.yftech.multimedia.MediaApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">
        <uses-library android:name="com.yftech.car.framework"/>
        <uses-library android:name="com.yftech.vehicle.sdk"/>
        <uses-library android:name="com.yftech.vehicle.internal.adapter"/>
        <activity
            android:name="com.yftech.multimedia.MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"
            android:alwaysRetainTaskState="true">
            <intent-filter>
                <action android:name="com.yftech.intent.action.start.video"/>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.yftech.libgallery.ui.FullScreenImageActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.yftech.libgallery.ui.BrowseImageActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.yftech.libmedia.player.PlayActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.yftech.libmusic.MusicMainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection">
            <intent-filter>
                <action android:name="com.yftech.intent.action.start.music"/>
                <action android:name="com.yftech.intent.action.start.music.bt"/>
                <action android:name="com.yftech.intent.action.start.music.usb"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.yftech.libmusic.ui.MusicListFromHardDiskActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.yftech.libmusic.ui.MusicSearchFromHardDiskActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name="com.yftech.libradio.RadioMainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection">
            <intent-filter>
                <action android:name="com.yftech.intent.action.start.radio"/>
                <action android:name="com.yftech.intent.action.start.radio.am"/>
                <action android:name="com.yftech.intent.action.start.radio.fm"/>
                <action android:name="com.yftech.intent.action.start.dabradio"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.yftech.libradio.dabui.DabSortListActivity"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"/>
        <activity
            android:name="com.yftech.libradio.dabui.DabFavorListActivity"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"/>
        <activity
            android:name="com.yftech.libradio.dabui.epg.EpgActivity"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"/>
        <activity
            android:name="com.yftech.libradio.RadioListActivity"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"/>
        <activity
            android:name="com.yftech.libradio.RadioFavorActivity"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection"/>
        <receiver android:name="com.yftech.libradio.receiver.AnnounceReceiver">
            <intent-filter>
                <action android:name="com.yftech.intent.action.dab.announce.play"/>
                <action android:name="com.yftech.intent.action.rds.trafic.announce.play"/>
                <action android:name="com.yftech.intent.action.dab.epg.play.event"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
