<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="40px"
        android:layout_marginTop="48px">
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:id="@+id/tv_station_name_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/station_name_with_count"
            android:layout_marginStart="216px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/type"
            android:layout_marginStart="848px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/station_service_group"
            android:layout_marginStart="1168px"/>
    </RelativeLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="1524px"
        android:layout_height="2px"
        android:layout_marginTop="110px"
        android:layout_marginStart="216px"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/layout_no_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="156px"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/pic_error_image"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="317px"
                android:text="@string/radio_channel_search_dialog_none_of_list_tips"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="6px"
            android:scrollbarThumbVertical="@mipmap/scroll_bar_music_list_slider_light"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/rv_all_stationg_list"
            android:background="@android:color/transparent"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="102px"
            android:scrollbarFadeDuration="4000"
            android:paddingEnd="8px"
            android:layout_marginStart="130px"
            android:layout_marginEnd="140px"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_margin="8px"
            android:src="@mipmap/radio_btn_reach_top"
            android:layout_alignBottom="@+id/rv_all_stationg_list"
            android:layout_alignEnd="@+id/rv_all_stationg_list"/>
    </RelativeLayout>
</RelativeLayout>
