<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="36px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_item_date"
        android:paddingTop="18px"
        android:paddingBottom="18px"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/lin_list_item"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/fl_viewed"
            android:padding="4px"
            android:layout_width="400px"
            android:layout_height="225px">
            <com.media.common.ui.widget.SyncImageView
                android:layout_gravity="center"
                android:id="@+id/iv_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="10dp"
                app:error="@mipmap/pv_vid_error1"
                app:placeHolder="@mipmap/pv_vid_error1"/>
            <TextView
                android:textSize="32px"
                android:textColor="@color/colorFFFFFF"
                android:gravity="center_horizontal"
                android:layout_gravity="bottom"
                android:id="@+id/tv_tips"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15px"
                android:text="@string/common_cannot_open"/>
        </FrameLayout>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:lines="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/colorCBCBCB"
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5px"
            android:layout_marginStart="10px"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
</FrameLayout>
