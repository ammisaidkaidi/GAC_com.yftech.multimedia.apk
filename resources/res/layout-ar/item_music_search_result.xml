<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.media.common.ui.widget.SyncImageView
        android:id="@+id/iv_cover"
        android:layout_width="88px"
        android:layout_height="88px"
        android:src="@mipmap/music_pic_folder"
        app:error="@mipmap/music_search_pic_cover"
        app:placeHolder="@mipmap/music_search_pic_cover"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="428px"
        android:layout_height="wrap_content"
        android:layout_marginStart="24px">
        <ImageView
            android:id="@+id/iv_isPlaying"
            android:background="@drawable/music_playing"
            android:layout_width="46px"
            android:layout_height="46px"
            android:layout_marginEnd="6px"/>
        <com.media.common.ui.widget.MarqueeView
            android:id="@+id/tv_name"
            android:background="@color/transparent"
            android:layout_width="380px"
            android:layout_height="88px"
            app:marqueeview_is_resetLocation="true"
            app:marqueeview_isclickalbe_stop="false"
            app:marqueeview_keywords_color="@color/colorDD9D09"
            app:marqueeview_repet_type="repet_interval"
            app:marqueeview_text_color="@color/music_list_selector"
            app:marqueeview_text_size="32"
            app:marqueeview_text_speed="0.5"
            app:marqueeview_text_startlocationdistance="0.03"/>
    </LinearLayout>
    <com.media.common.ui.widget.MarqueeView
        android:id="@+id/tv_artist"
        android:layout_width="240px"
        android:layout_height="88px"
        android:layout_marginStart="60px"
        app:marqueeview_is_resetLocation="true"
        app:marqueeview_isclickalbe_stop="false"
        app:marqueeview_keywords_color="@color/colorDD9D09"
        app:marqueeview_repet_type="repet_interval"
        app:marqueeview_text_color="@color/music_list_selector"
        app:marqueeview_text_size="28"
        app:marqueeview_text_speed="0.5"
        app:marqueeview_text_startlocationdistance="0.03"/>
    <com.media.common.ui.widget.MarqueeView
        android:id="@+id/tv_album"
        android:background="@color/transparent"
        android:layout_width="340px"
        android:layout_height="88px"
        android:layout_marginStart="60px"
        app:marqueeview_is_resetLocation="true"
        app:marqueeview_isclickalbe_stop="false"
        app:marqueeview_keywords_color="@color/colorDD9D09"
        app:marqueeview_repet_type="repet_interval"
        app:marqueeview_text_color="@color/music_list_selector"
        app:marqueeview_text_size="28"
        app:marqueeview_text_speed="0.5"
        app:marqueeview_text_startlocationdistance="0.03"/>
</LinearLayout>
