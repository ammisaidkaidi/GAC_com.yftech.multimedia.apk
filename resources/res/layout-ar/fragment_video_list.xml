<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingEnd="104px">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/vlf_vid_usb"
        android:layout_width="wrap_content"
        android:layout_height="80px">
        <TextView
            android:textSize="38px"
            android:textColor="@color/pic_video_title_color_selector"
            android:layout_gravity="center_vertical"
            android:id="@+id/vid_usb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100px"
            android:text="USB"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@mipmap/pv_icon_arrow_nor_ar"
            android:layout_width="24px"
            android:layout_height="24px"
            android:layout_marginStart="23px"/>
        <TextView
            android:textSize="36px"
            android:textColor="@color/colorDD9D09"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_name"
            android:layout_marginStart="23px"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32px"
        android:layout_height="32px"
        android:layout_marginTop="24px"
        android:indeterminateDrawable="@drawable/progress_loading"
        android:indeterminateDuration="200"
        android:layout_marginStart="20px"
        android:layout_toEndOf="@+id/vlf_vid_usb"
        android:elevation="5px"/>
    <View
        android:id="@+id/vlf_pic_line"
        android:background="@color/color292921"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:layout_below="@+id/vlf_vid_usb"
        android:layout_marginEnd="23px"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/vlf_pic_line"
        android:overScrollMode="never"/>
</RelativeLayout>
