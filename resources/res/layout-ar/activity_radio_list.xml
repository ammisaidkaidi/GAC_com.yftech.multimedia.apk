<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:background="@mipmap/pic_bg2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32px"
        android:textColor="@color/colorB3FFFFFF"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="80px"
        android:text="@string/dab_tab_title_station_list"
        android:includeFontPadding="false"
        android:fontFamily="sourcehan-sans-medium"
        android:layout_marginStart="180px"/>
    <RelativeLayout
        android:id="@+id/layout_radio_search"
        android:background="@mipmap/btn_change_bg"
        android:layout_width="wrap_content"
        android:layout_height="53px"
        android:layout_marginTop="14px"
        android:minWidth="200px"
        android:layout_marginEnd="485px"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/radio_channel_search_dialog_title"
            android:layout_centerInParent="true"
            android:drawableStart="@mipmap/icon_change"/>
    </RelativeLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="1636px"
        android:layout_height="3dp"
        android:layout_marginTop="77px"
        android:layout_marginStart="180px"/>
    <RelativeLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="40px"
        android:layout_marginTop="128px">
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:id="@+id/tv_station_name_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/station_name_with_count"
            android:layout_marginStart="216px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:id="@+id/tv_pty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/type"
            android:layout_marginStart="1156px"/>
    </RelativeLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginTop="188px"
        android:layout_marginStart="216px"
        android:layout_marginEnd="104px"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/pb_list"
            android:layout_width="50px"
            android:layout_height="50px"
            android:indeterminateDrawable="@drawable/progress_loading"
            android:indeterminateDuration="200"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:id="@+id/layout_no_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80px"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="104px"
                android:src="@mipmap/pic_error_image"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="421px"
                android:text="@string/radio_channel_search_dialog_none_of_list_tips"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="6px"
            android:scrollbarThumbVertical="@mipmap/scroll_bar_music_list_slider_light"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/rv_radio_list"
            android:background="@android:color/transparent"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="182px"
            android:scrollbarFadeDuration="4000"
            android:paddingEnd="8px"
            android:layout_marginStart="130px"
            android:layout_marginEnd="140px"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_margin="8px"
            android:src="@mipmap/radio_btn_reach_top"
            android:layout_alignBottom="@+id/rv_radio_list"
            android:layout_alignEnd="@+id/rv_radio_list"/>
    </RelativeLayout>
</RelativeLayout>
