<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingEnd="106px">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/plf_pic_usb"
        android:layout_width="wrap_content"
        android:layout_height="80px">
        <TextView
            android:textSize="38px"
            android:textColor="@color/pic_video_title_color_selector"
            android:layout_gravity="center_vertical"
            android:id="@+id/pic_usb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100px"
            android:text="USB1"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@mipmap/pv_icon_arrow_nor"
            android:layout_width="24px"
            android:layout_height="24px"/>
        <TextView
            android:textSize="36px"
            android:textColor="@color/colorDD9D09"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pic_name"
            android:layout_marginStart="23px"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32px"
        android:layout_height="32px"
        android:layout_marginTop="24px"
        android:indeterminateDrawable="@drawable/progress_loading"
        android:indeterminateDuration="200"
        android:layout_marginStart="20px"
        android:layout_toEndOf="@+id/plf_pic_usb"
        android:elevation="5px"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_title_default"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/music_audio_btn_bg"
        android:visibility="invisible"
        android:layout_width="160px"
        android:layout_height="56px"
        android:layout_marginTop="12px"
        android:text="@string/common_cancel"
        android:layout_marginEnd="20px"
        android:layout_toStartOf="@+id/btn_selector"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/color_title_default"
        android:gravity="center"
        android:id="@+id/btn_selector"
        android:background="@drawable/music_audio_btn_bg"
        android:visibility="invisible"
        android:layout_width="160px"
        android:layout_height="56px"
        android:layout_marginTop="12px"
        android:text="@string/common_select"
        android:layout_marginEnd="10px"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/plf_pic_line"
        android:background="@color/color292921"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:layout_below="@+id/plf_pic_usb"
        android:layout_marginEnd="23px"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/plf_pic_line"
        android:overScrollMode="never"/>
</RelativeLayout>
