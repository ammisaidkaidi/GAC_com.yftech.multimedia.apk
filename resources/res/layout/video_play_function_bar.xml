<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_control"
        android:layout_width="52px"
        android:layout_height="52px"
        android:src="@drawable/video_play_state_selector"
        android:layout_marginStart="113px"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_next"
        android:layout_width="46px"
        android:layout_height="46px"
        android:src="@drawable/imgvideo_icon_next"
        android:layout_marginStart="53px"/>
    <ImageView
        android:id="@+id/iv_full_screen"
        android:visibility="gone"
        android:layout_width="70px"
        android:layout_height="70px"
        android:layout_marginTop="10px"
        android:src="@drawable/imgvideo_icon_fullscreen01"
        android:layout_marginStart="4px"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_time_index"
        android:layout_width="wrap_content"
        android:layout_height="33px"
        android:layout_marginTop="32px"
        android:minWidth="97px"
        android:text="00:00:00"
        android:layout_marginStart="72px"/>
    <com.yftech.car.widget.media.view.MediaSeekBar
        android:id="@+id/sb_video"
        android:layout_width="554px"
        android:layout_height="100px"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_for_video_track"
        android:thumb="@drawable/seekbar_for_video_thumb"
        android:paddingStart="30px"
        android:paddingEnd="30px"
        android:layout_marginStart="10px"
        android:splitTrack="false"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_time_total"
        android:layout_width="wrap_content"
        android:layout_height="33px"
        android:layout_marginTop="32px"
        android:minWidth="97px"
        android:text="00:00:00"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_volume"
        android:layout_width="48px"
        android:layout_height="48px"
        android:src="@mipmap/pv_icon_volume_on_02"
        android:layout_marginStart="56px"/>
    <SeekBar
        android:layout_gravity=""
        android:id="@+id/sb_volume"
        android:layout_width="291px"
        android:layout_height="100px"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_for_video_track"
        android:thumb="@drawable/seekbar_for_video_thumb"
        android:paddingStart="30px"
        android:paddingEnd="30px"
        android:splitTrack="false"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorFFFFFF"
        android:layout_gravity="center"
        android:id="@+id/tv_volume_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="60%"/>
</LinearLayout>
