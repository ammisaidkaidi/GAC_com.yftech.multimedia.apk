<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.media.common.ui.widget.FlowRadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_eq_mode"
        android:layout_width="match_parent"
        android:layout_height="188px">
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="32px"
                    android:textStyle="bold"
                    android:textColor="@color/colorFFFFFF"
                    android:id="@+id/rb_eq_sound_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="54px"
                    android:text="@string/music_sound_effects_dialog_EQ_title"
                    android:layout_alignParentStart="true"/>
                <RadioButton
                    android:textSize="28px"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_1"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_1"
                    android:layout_alignTop="@+id/rb_eq_mode_2"
                    android:layout_marginEnd="18px"
                    android:layout_toStartOf="@+id/rb_eq_mode_2"/>
                <RadioButton
                    android:textSize="28px"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_2"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_2"
                    android:layout_alignTop="@+id/rb_eq_mode_3"
                    android:layout_marginEnd="18px"
                    android:layout_toStartOf="@+id/rb_eq_mode_3"/>
                <RadioButton
                    android:textSize="28px"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_3"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_3"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28px">
                <RadioButton
                    android:textSize="28px"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_4"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_4"
                    android:layout_alignTop="@+id/rb_eq_mode_5"
                    android:layout_marginEnd="18px"
                    android:layout_toStartOf="@+id/rb_eq_mode_5"/>
                <RadioButton
                    android:textSize="28px"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_5"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_5"
                    android:layout_alignTop="@+id/rb_eq_mode_6"
                    android:layout_marginEnd="18px"
                    android:layout_toStartOf="@+id/rb_eq_mode_6"/>
                <RadioButton
                    android:textSize="@dimen/music_effect_custom_text_size"
                    android:textColor="@color/music_eq_setting_selector"
                    android:gravity="center"
                    android:id="@+id/rb_eq_mode_6"
                    android:background="@drawable/music_eq_setting_selector3"
                    android:layout_width="144px"
                    android:layout_height="56px"
                    android:button="@android:color/transparent"
                    android:text="@string/music_sound_effects_dialog_EQ_mode_6"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </com.media.common.ui.widget.FlowRadioGroup>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_marginStart="62px">
        <TextView
            android:textSize="@dimen/music_sound_effects_dialog_EQ_mode_detail_value_text_size"
            android:textColor="@color/colorE6FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_sound_effects_dialog_EQ_mode_detail_value_1"/>
        <View
            android:layout_width="0px"
            android:layout_height="0px"
            android:layout_weight="1"/>
        <TextView
            android:textSize="34px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="end"
            android:id="@+id/tv_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="29px"
            android:text="-7"
            android:textDirection="ltr"/>
        <com.media.common.ui.widget.SeekBarView
            android:gravity="center"
            android:id="@+id/seekBar_high"
            android:background="@android:color/transparent"
            android:layout_width="515px"
            android:layout_height="match_parent"
            android:layout_marginTop="8px"
            app:backColor="@color/color33FFFFFF"
            app:backFrameColor="@color/color33FFFFFF"
            app:backFrameSize="0px"
            app:backHeight="12px"
            app:centerState="true"
            app:maxProgress="100"
            app:minProgress="0"
            app:onlyChangedProgressByThumb="false"
            app:progress="0"
            app:progressColor="@color/colorFFEEAA17"
            app:progressHeightColor="@color/colorFFFFEF57"
            app:textBackRadius="6px"
            app:textLocation="3"
            app:thumbColor="@color/colorCCDDFF"
            app:thumbNormalRadius="17px"
            app:thumbPressRadius="25px"
            app:width="465px"/>
    </LinearLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginStart="62px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_marginStart="62px">
        <TextView
            android:textSize="@dimen/music_sound_effects_dialog_EQ_mode_detail_value_text_size"
            android:textColor="@color/colorE6FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_sound_effects_dialog_EQ_mode_detail_value_2"/>
        <View
            android:layout_width="0px"
            android:layout_height="0px"
            android:layout_weight="1"/>
        <TextView
            android:textSize="34px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="end"
            android:id="@+id/tv_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="29px"
            android:text="-7"
            android:textDirection="ltr"/>
        <com.media.common.ui.widget.SeekBarView
            android:gravity="center_vertical"
            android:id="@+id/seekBar_middle"
            android:background="@android:color/transparent"
            android:layout_width="515px"
            android:layout_height="match_parent"
            android:layout_marginTop="8px"
            app:backColor="@color/color33FFFFFF"
            app:backFrameColor="@color/color33FFFFFF"
            app:backFrameSize="0px"
            app:backHeight="12px"
            app:centerState="true"
            app:maxProgress="100"
            app:minProgress="0"
            app:onlyChangedProgressByThumb="false"
            app:progress="0"
            app:progressColor="@color/colorFFEEAA17"
            app:progressHeightColor="@color/colorFFFFEF57"
            app:textBackRadius="6px"
            app:textLocation="3"
            app:thumbColor="@color/colorCCDDFF"
            app:thumbNormalRadius="17px"
            app:thumbPressRadius="25px"
            app:width="465px"/>
    </LinearLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginStart="62px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_marginStart="62px">
        <TextView
            android:textSize="@dimen/music_sound_effects_dialog_EQ_mode_detail_value_text_size"
            android:textColor="@color/colorE6FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_sound_effects_dialog_EQ_mode_detail_value_3"/>
        <View
            android:layout_width="0px"
            android:layout_height="0px"
            android:layout_weight="1"/>
        <TextView
            android:textSize="34px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="end"
            android:id="@+id/tv_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="29px"
            android:text="-7"
            android:textDirection="ltr"/>
        <com.media.common.ui.widget.SeekBarView
            android:gravity="center_vertical"
            android:id="@+id/seekBar_low"
            android:background="@android:color/transparent"
            android:layout_width="515px"
            android:layout_height="match_parent"
            android:layout_marginTop="8px"
            app:backColor="@color/color33FFFFFF"
            app:backFrameColor="@color/color33FFFFFF"
            app:backFrameSize="0px"
            app:backHeight="12px"
            app:centerState="true"
            app:maxProgress="100"
            app:minProgress="0"
            app:onlyChangedProgressByThumb="false"
            app:progress="0"
            app:progressColor="@color/colorFFEEAA17"
            app:progressHeightColor="@color/colorFFFFEF57"
            app:textBackRadius="6px"
            app:textLocation="3"
            app:thumbColor="@color/colorCCDDFF"
            app:thumbNormalRadius="17px"
            app:thumbPressRadius="25px"
            app:width="465px"/>
    </LinearLayout>
</LinearLayout>
