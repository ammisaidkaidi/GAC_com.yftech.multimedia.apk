<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26px"
        android:layoutDirection="ltr"
        android:layout_marginStart="120px"
        android:layout_marginEnd="70px">
        <ImageView
            android:id="@+id/iv_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dab_icon_epg_last"
            android:layout_centerVertical="true"
            android:layout_marginEnd="100px"
            android:layout_toStartOf="@+id/tv_date_sel"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="center"
            android:id="@+id/tv_date_sel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="210px"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/dab_icon_epg_next"
            android:layout_centerVertical="true"
            android:layout_marginStart="100px"
            android:layout_toEndOf="@+id/tv_date_sel"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_line"
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginTop="88px"
        android:layout_marginStart="292px"
        android:layout_marginEnd="104px"/>
    <RelativeLayout
        android:id="@+id/list_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_line">
        <RelativeLayout
            android:id="@+id/layout_no_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="83px"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/pic_error_image"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:id="@+id/tv_no_epg_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="317px"
                android:text="@string/dab_epg_none_of_list_tips"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="6px"
            android:scrollbarThumbVertical="@mipmap/scroll_bar_music_list_slider_light"
            android:id="@+id/rv_dab_epg_list"
            android:background="@color/color000000"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarFadeDuration="4000"
            android:layout_marginStart="193px"
            android:layout_marginEnd="24px"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_margin="8px"
            android:src="@mipmap/radio_btn_reach_top"
            android:layout_alignBottom="@+id/rv_dab_epg_list"
            android:layout_alignEnd="@+id/rv_dab_epg_list"/>
        <ProgressBar
            android:id="@+id/pb_list"
            android:layout_width="50px"
            android:layout_height="50px"
            android:indeterminateDrawable="@drawable/progress_loading"
            android:indeterminateDuration="200"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
