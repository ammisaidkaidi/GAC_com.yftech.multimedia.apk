<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_lable_set"
        android:background="@drawable/shape_selected_lable_bg"
        android:layout_width="wrap_content"
        android:layout_height="56px"
        android:layout_marginTop="12px"
        android:layout_marginStart="180px">
        <TextView
            android:textSize="24px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_list_lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24px"
            android:layout_marginRight="24px"
            android:minWidth="146px"
            android:singleLine="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_lable_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8px"
            android:src="@mipmap/icon_label_chose"
            android:layout_toRightOf="@+id/tv_list_lable"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/layout_no_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="156px"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/pic_error_image"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="317px"
                android:text="@string/radio_channel_search_dialog_none_of_list_tips"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="6px"
            android:scrollbarThumbVertical="@mipmap/scroll_bar_music_list_slider_light"
            android:scrollbarStyle="outsideInset"
            android:id="@+id/rv_station_list_list"
            android:background="@android:color/transparent"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="92px"
            android:scrollbarFadeDuration="4000"
            android:paddingEnd="42px"
            android:layout_marginStart="180px"
            android:layout_marginEnd="24px"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_margin="8px"
            android:src="@mipmap/radio_btn_reach_top"
            android:layout_alignBottom="@+id/rv_station_list_list"
            android:layout_alignEnd="@+id/rv_station_list_list"/>
    </RelativeLayout>
</RelativeLayout>
