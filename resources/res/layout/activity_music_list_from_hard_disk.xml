<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false"
    android:paddingStart="140px">
    <include
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40px"
        android:layout_marginEnd="70px"
        layout="@layout/music_list_action_bar"/>
    <RelativeLayout
        android:id="@+id/lin_tag"
        android:layout_width="380px"
        android:layout_height="match_parent"
        android:layout_below="@+id/actionBar">
        <ImageView
            android:id="@+id/iv_tag"
            android:layout_width="300px"
            android:layout_height="300px"
            android:layout_marginTop="40px"
            android:src="@mipmap/music_pic_cover_usb"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_start"
            android:visibility="invisible"
            android:layout_width="96px"
            android:layout_height="100px"
            android:src="@drawable/music_list_from_hard_disk_control_selector"
            android:layout_alignBottom="@+id/iv_tag"
            android:layout_marginStart="16px"
            android:layout_alignStart="@+id/iv_tag"/>
        <View
            android:id="@+id/v_ref"
            android:background="@mipmap/music_pic_cover_usb_shadow"
            android:layout_width="300px"
            android:layout_height="270px"
            android:layout_marginTop="20px"
            android:layout_below="@+id/iv_tag"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="95px"
            android:layout_marginTop="30px"
            android:text="."
            android:maxLines="2"
            android:layout_below="@+id/iv_tag"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="56px"
            android:layout_marginEnd="56px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/color_title_default"
            android:gravity="center"
            android:id="@+id/btn_playAll"
            android:background="@drawable/music_btn_bg"
            android:layout_width="200px"
            android:layout_height="62px"
            android:text="@string/common_play_all"
            android:layout_below="@+id/tv_file_name"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/actionBar"
        android:layout_marginStart="50px"
        android:layout_marginEnd="70px"
        android:layout_toEndOf="@+id/lin_tag">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="33px"
            android:layout_width="match_parent"
            android:layout_height="88px">
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorB3FFFFFF"
                android:gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="56px"
                android:layout_height="40px"
                android:text="@string/music_list_from_usb_title_0"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorB3FFFFFF"
                android:gravity="center_vertical"
                android:id="@+id/tv_music_count"
                android:layout_width="120px"
                android:layout_height="40px"
                android:text="（149）"
                android:layout_marginStart="12px"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorB3FFFFFF"
                android:gravity="center_vertical"
                android:layout_width="240px"
                android:layout_height="40px"
                android:text="@string/music_list_from_usb_title_1"
                android:layout_marginStart="402px"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorB3FFFFFF"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="40px"
                android:text="@string/music_list_from_usb_title_2"
                android:layout_marginStart="60px"/>
        </LinearLayout>
        <View
            android:background="@color/color26CCDDFF"
            android:layout_width="1080px"
            android:layout_height="2px"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_loading"
                android:visibility="gone"
                android:layout_width="80px"
                android:layout_height="80px"
                android:indeterminateDrawable="@drawable/progress_loading"
                android:indeterminateDuration="200"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20px"
                android:layout_marginBottom="20px"
                android:overScrollMode="never"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
