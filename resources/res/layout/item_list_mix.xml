<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="36px"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/tv_item_date"
        android:paddingTop="18px"
        android:paddingBottom="18px"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/iv_pic"
        android:visibility="visible"
        android:layout_width="230px"
        android:layout_height="230px"
        android:scaleType="centerCrop"
        android:paddingEnd="1px"/>
    <ImageView
        android:id="@+id/iv_cover"
        android:background="@drawable/picture_item_click_selector"
        android:visibility="visible"
        android:layout_width="230px"
        android:layout_height="230px"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:id="@+id/tv_tips"
        android:visibility="invisible"
        android:layout_width="230px"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20px"
        android:text="@string/common_cannot_open"/>
    <View
        android:id="@+id/v_isSelected"
        android:background="@drawable/picture_selector"
        android:layout_width="35px"
        android:layout_height="35px"
        android:layout_margin="20px"/>
</FrameLayout>
