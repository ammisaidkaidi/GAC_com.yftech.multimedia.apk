<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingTop="90px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false"
    android:paddingStart="298px"
    android:paddingEnd="298px">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10px">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="0px"
            android:layout_height="72px"
            android:src="@mipmap/icon_gengduo"
            android:layout_centerVertical="true"/>
        <EditText
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:textColorHint="@color/color66FFFFFF"
            android:gravity="center_vertical"
            android:id="@+id/et_search"
            android:background="@drawable/pic_dialog_search"
            android:layout_width="wrap_content"
            android:layout_height="112px"
            android:hint="@string/music_search_hint"
            android:maxLines="1"
            android:drawablePadding="27px"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textSelectHandle="@color/transparent"
            android:textIsSelectable="false"
            android:textCursorDrawable="@drawable/edit_cursor"
            android:drawableStart="@mipmap/music_icon_sousuo1"
            android:paddingStart="55px"
            android:paddingEnd="132px"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="28dp"
            android:layout_toStartOf="@+id/tv_cancel"
            android:layout_toEndOf="@+id/iv_back"/>
        <ImageView
            android:id="@+id/iv_clear"
            android:visibility="visible"
            android:layout_width="32px"
            android:layout_height="32px"
            android:src="@drawable/btn_clear_selector"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40px"
            android:layout_alignEnd="@+id/et_search"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/color_title_default"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/music_btn_bg"
            android:layout_width="200px"
            android:layout_height="66px"
            android:text="@string/common_cancel"
            android:layout_centerVertical="true"
            android:layout_marginEnd="30px"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.media.common.ui.widget.FlowLayout
        android:id="@+id/fl_hot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
