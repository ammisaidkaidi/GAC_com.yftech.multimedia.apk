<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/pic_label_bg"
    android:layout_width="1010px"
    android:layout_height="640px">
    <RelativeLayout
        android:padding="20px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/layout_tilte"
            android:layout_width="match_parent"
            android:layout_height="78px"
            android:layout_marginStart="24px">
            <TextView
                android:textSize="24px"
                android:textColor="@color/colorFFFFFF"
                android:ellipsize="end"
                android:id="@+id/tv_title_filter_sel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="427px"
                android:text="@string/pty_types"
                android:singleLine="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/icon_label_chose"
                android:layout_centerVertical="true"
                android:layout_marginStart="24px"
                android:layout_toEndOf="@+id/tv_title_filter_sel"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dab_label_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="88px"
            android:layout_marginStart="26px"
            android:layout_marginEnd="26px"/>
    </RelativeLayout>
</FrameLayout>
