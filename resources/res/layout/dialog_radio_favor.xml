<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/radio_pic_card_bg"
    android:layout_width="592px"
    android:layout_height="740px">
    <RelativeLayout
        android:padding="22px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rel_title"
            android:layout_width="match_parent"
            android:layout_height="75px"
            android:layout_marginTop="10px"
            android:layout_marginBottom="0px"
            android:layout_marginStart="10px"
            android:layout_marginEnd="10px">
            <TextView
                android:textSize="32px"
                android:textStyle="bold"
                android:textColor="@color/colorFFFFFF"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio_channel_favor_dialog_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="30px"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:id="@+id/tv_num"
                android:layout_width="wrap_content"
                android:layout_height="36px"
                android:text="(0)"
                android:layout_centerVertical="true"
                android:layout_marginStart="10px"
                android:layout_toEndOf="@+id/tv_title"/>
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="40px"
                android:layout_height="40px"
                android:src="@drawable/fm_cardlist_icon_close"
                android:layout_centerVertical="true"
                android:layout_marginEnd="30px"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/fv_split_line"
            android:background="@color/color1ACCDDFF"
            android:layout_width="520px"
            android:layout_height="2px"
            android:layout_marginTop="90px"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/rl_search_fail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rel_title"
            android:layout_marginStart="10px"
            android:layout_marginEnd="10px">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="276px"
                android:layout_height="274px"
                android:layout_marginTop="88px"
                android:src="@mipmap/radio_error_image"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorFFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="43px"
                android:text="@string/radio_channel_favor_dialog_none_of_list_tips"
                android:layout_below="@+id/iv_icon"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10px"
            android:layout_below="@+id/fv_split_line"
            android:scrollbarFadeDuration="4000"
            android:layout_marginStart="10px"
            android:layout_marginEnd="15px"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/pic_list_mask_top_520"
            android:layout_alignTop="@+id/rv"
            android:layout_alignStart="@+id/rv"/>
        <ProgressBar
            android:id="@+id/pb_list"
            android:layout_width="50px"
            android:layout_height="50px"
            android:indeterminateDrawable="@drawable/progress_loading"
            android:indeterminateDuration="200"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_margin="8px"
            android:src="@mipmap/radio_btn_reach_top"
            android:layout_alignBottom="@+id/rv"
            android:layout_alignEnd="@+id/rv"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/pic_list_mask_bottom"
            android:layout_alignBottom="@+id/rv"/>
    </RelativeLayout>
</FrameLayout>
