<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80px">
    <TextView
        android:textSize="38px"
        android:textStyle="bold"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_actionbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title"
        android:layout_alignTop="@+id/iv_back"
        android:layout_alignBottom="@+id/iv_back"
        android:layout_toEndOf="@+id/iv_back"/>
    <TextView
        android:textSize="38px"
        android:textStyle="bold"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_split"
        android:layout_width="44px"
        android:layout_height="wrap_content"
        android:text="/"
        android:layout_alignTop="@+id/tv_actionbar_title"
        android:layout_alignBottom="@+id/tv_actionbar_title"
        android:layout_toEndOf="@+id/tv_actionbar_title"/>
    <com.media.common.ui.widget.ScrollableTextView
        android:id="@+id/tv_subtitle"
        android:layout_width="255px"
        android:layout_height="wrap_content"
        android:layout_marginTop="5px"
        android:layout_alignTop="@+id/tv_actionbar_title"
        android:layout_alignBottom="@+id/tv_actionbar_title"
        android:layout_toEndOf="@+id/tv_split"
        app:scrollable_text_view_textAlignment="end"
        app:scrollable_text_view_textColor="@color/colorDD9D09"
        app:scrollable_text_view_textSize="32px"/>
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="0px"
        android:layout_height="80px"
        android:src="@mipmap/icon_gengduo"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorB3FFFFFF"
        android:gravity="center"
        android:id="@+id/iv_search"
        android:background="@drawable/music_action_bar_btn_bg"
        android:layout_width="wrap_content"
        android:layout_height="56px"
        android:minWidth="180px"
        android:text="@string/music_search_in_list"
        android:drawableLeft="@mipmap/icon_sousuo"
        android:layout_centerVertical="true"
        android:paddingStart="38px"
        android:paddingEnd="30px"
        android:layout_marginStart="735px"
        android:layout_toEndOf="@+id/tv_subtitle"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/color26CCDDFF"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_alignBottom="@+id/iv_back"/>
</RelativeLayout>
