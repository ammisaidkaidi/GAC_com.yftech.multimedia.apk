<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/music_source_select_text_size"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_music_source"
        android:background="@drawable/music_btn_bg"
        android:layout_width="200px"
        android:layout_height="72px"
        android:layout_marginTop="50px"
        android:text="@string/music_source_selector"
        android:layout_marginStart="110px"/>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="110px">
        <TextView
            android:textSize="56px"
            android:textStyle="bold"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="74px"
            android:text="@string/music_welcome_title"/>
        <TextView
            android:textSize="36px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8px"
            android:text="@string/music_welcome_subtitle"/>
    </LinearLayout>
</FrameLayout>
