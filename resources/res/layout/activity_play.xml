<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_cover"
        android:background="@color/color000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10px"/>
    <com.yftech.car.media.video.VideoPlayer
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.media.common.ui.widget.MyActionBar
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="70px"
        app:showLine="false"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_progress"
        android:background="@android:color/darker_gray"
        android:visibility="invisible"
        android:layout_width="320px"
        android:layout_height="180px"
        android:layout_marginBottom="100px">
        <ImageView
            android:id="@+id/iv_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_front"
                android:layout_width="46px"
                android:layout_height="46px"
                android:src="@mipmap/pv_icon_backward"
                android:layout_marginEnd="20px"/>
            <TextView
                android:textSize="28px"
                android:textColor="@color/colorCBCBCB"
                android:layout_gravity="center"
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"/>
            <ImageView
                android:id="@+id/iv_behind"
                android:layout_width="46px"
                android:layout_height="46px"
                android:src="@mipmap/pv_icon_quick"
                android:layout_marginStart="20px"/>
        </LinearLayout>
    </FrameLayout>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/video_play_function_bar"/>
</FrameLayout>
