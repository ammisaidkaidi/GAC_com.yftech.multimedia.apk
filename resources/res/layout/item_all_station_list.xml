<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112px">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px">
        <View
            android:id="@+id/iv_background"
            android:background="@mipmap/music_search_pic_songlist_light"
            android:layout_width="match_parent"
            android:layout_height="88px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24px"/>
        <ImageView
            android:id="@+id/iv_station_icon"
            android:layout_width="88px"
            android:layout_height="88px"
            android:src="@mipmap/pic_list_tiny_default"
            android:scaleType="fitXY"
            android:layout_marginStart="86px"/>
        <ImageView
            android:id="@+id/iv_play_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_playing"
            android:layout_centerVertical="true"
            android:layout_marginStart="204px"
            android:layout_marginEnd="12px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="360px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="256px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="716px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_service_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="1036px"/>
    </RelativeLayout>
</RelativeLayout>
