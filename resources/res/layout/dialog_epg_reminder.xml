<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_rootview"
    android:background="@drawable/pic_dialog_bg"
    android:padding="22px"
    android:layout_width="836px"
    android:layout_height="372px">
    <TextView
        android:textSize="36px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34px"
        android:text="@string/epg_reminder_title"
        android:includeFontPadding="false"
        android:fontFamily="sourcehan-sans-bold"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/radio_channel_search_dialog_search_fail_tips"
        android:layout_below="@+id/tv_title"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/color26CCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_above="@+id/rl_result"/>
    <RelativeLayout
        android:id="@+id/rl_result"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:id="@+id/tv_litener"
            android:background="@drawable/selector_dialog_left_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/epg_reminder_confirm1"
            android:layout_toStartOf="@+id/v_drive"/>
        <View
            android:id="@+id/v_drive"
            android:background="@color/color26CCDDFF"
            android:layout_width="2px"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/selector_dialog_right_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/radio_loading_common_cancel"
            android:layout_toEndOf="@+id/v_drive"/>
    </RelativeLayout>
</RelativeLayout>
