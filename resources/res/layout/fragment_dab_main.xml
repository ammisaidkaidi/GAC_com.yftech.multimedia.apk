<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:background="@mipmap/home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/layout_lables"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="672px"
        android:layout_marginTop="98px">
        <TextView
            android:textSize="52px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_service_lable"
            android:layout_width="656px"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="sourcehan-sans-medium"/>
        <TextView
            android:textSize="30px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_pty_ensemble"
            android:layout_width="472px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="92px"
            android:layout_marginTop="68px"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="sourcehan-sans-regular"/>
    </RelativeLayout>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorB3FFFFFF"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_pty_frequency"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150px"
        android:layout_marginRight="100px"
        android:singleLine="true"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorB3FFFFFF"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_rssi"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:layout_marginRight="20px"
        android:text="信号强度: 20db"
        android:singleLine="true"
        android:layout_below="@+id/tv_pty_frequency"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorB3FFFFFF"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_snr"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:layout_marginRight="20px"
        android:text="信噪比: 20db"
        android:singleLine="true"
        android:layout_below="@+id/tv_rssi"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="28px"
        android:textColor="@color/colorB3FFFFFF"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_vber"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:layout_marginRight="20px"
        android:minWidth="80px"
        android:singleLine="true"
        android:layout_below="@+id/tv_snr"
        android:layout_alignParentRight="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dab_service_list"
        android:layout_width="460px"
        android:layout_height="182px"
        android:layout_marginLeft="771px"
        android:layout_marginTop="239px"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="43px"
        android:layout_alignParentBottom="true"
        layout="@layout/dab_control_bar"/>
</RelativeLayout>
