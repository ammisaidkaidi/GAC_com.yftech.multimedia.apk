<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fl_main"
    android:background="@mipmap/music_main_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_playing"
        android:background="@drawable/music_play_status_anim"
        android:layout_width="1300px"
        android:layout_height="230px"
        android:layout_marginTop="245px"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_playing_extra"
        android:background="@drawable/music_play_status_anim_extra"
        android:layout_width="600px"
        android:layout_height="100px"
        android:layout_marginTop="480px"
        android:layout_marginEnd="185px"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_playing_extra_reflection"
        android:background="@mipmap/playing_extra_reflection"
        android:layout_width="600px"
        android:layout_height="100px"
        android:layout_marginTop="530px"
        android:layout_marginEnd="185px"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_album"
        android:layout_width="320px"
        android:layout_height="320px"
        android:layout_marginTop="150px"
        android:src="@mipmap/music_main_pic_cover"
        android:layout_marginEnd="320px"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_sound_effects"
        android:visibility="gone"
        android:layout_width="80px"
        android:layout_height="80px"
        android:layout_marginTop="82px"
        android:src="@drawable/music_dts_selector"
        android:layout_marginEnd="109px"/>
    <View
        android:id="@+id/v_click"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="5px"/>
    <FrameLayout
        android:id="@+id/fl_music"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
