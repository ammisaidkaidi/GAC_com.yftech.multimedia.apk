<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/music_cardlist_pic_bg"
    android:layout_width="580px"
    android:layout_height="match_parent">
    <RelativeLayout
        android:padding="22px"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rel_title"
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:layout_marginTop="10px"
            android:layout_marginBottom="10px"
            android:layout_marginStart="10px"
            android:layout_marginEnd="10px">
            <TextView
                android:textSize="36px"
                android:textStyle="bold"
                android:textColor="@color/colorFFFFFF"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_song_list_dialog_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="10px"/>
            <TextView
                android:textSize="30px"
                android:textColor="@color/colorFFFFFF"
                android:id="@+id/tv_num"
                android:layout_width="wrap_content"
                android:layout_height="46px"
                android:text="(0)"
                android:layout_alignBottom="@+id/tv_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="10px"
                android:layout_toEndOf="@+id/tv_title"/>
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="54px"
                android:layout_height="54px"
                android:src="@drawable/btn_close_selector"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/music_split_line"
            android:background="@color/color1ACCDDFF"
            android:layout_width="520px"
            android:layout_height="2px"
            android:layout_marginTop="112px"
            android:layout_centerHorizontal="true"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/music_split_line"
            android:scrollbarFadeDuration="4000"
            android:overScrollMode="never"
            android:layout_marginEnd="10px"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/music_pic_list_mask_top"
            android:layout_alignTop="@+id/rv"
            android:layout_alignStart="@+id/rv"/>
        <ProgressBar
            android:id="@+id/pb_pic"
            android:visibility="gone"
            android:layout_width="100px"
            android:layout_height="100px"
            android:indeterminateDrawable="@drawable/progress_loading"
            android:indeterminateDuration="200"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_toBoard"
            android:visibility="invisible"
            android:layout_width="128px"
            android:layout_height="128px"
            android:layout_marginTop="8px"
            android:layout_marginBottom="8px"
            android:src="@mipmap/music_btn_reach_top"
            android:layout_alignBottom="@+id/rv"
            android:layout_marginStart="8px"
            android:layout_marginEnd="8px"
            android:layout_alignEnd="@+id/rv"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/music_pic_list_mask_bottom"
            android:layout_alignBottom="@+id/rv"/>
    </RelativeLayout>
</FrameLayout>
