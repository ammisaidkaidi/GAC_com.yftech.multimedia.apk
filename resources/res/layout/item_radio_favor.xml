<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100px"
    android:paddingStart="35px">
    <ImageView
        android:id="@+id/iv_play"
        android:background="@drawable/music_playing"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_centerVertical="true"
        android:layout_marginEnd="18px"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/colorE6FFFFFF"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="@font/roboto_regular"
        android:layout_toEndOf="@+id/iv_play"/>
    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@mipmap/radio_favorite_icon_on"
        android:layout_centerVertical="true"
        android:layout_marginEnd="30px"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/color26CCDDFF"
        android:layout_width="460px"
        android:layout_height="2px"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"/>
</RelativeLayout>
