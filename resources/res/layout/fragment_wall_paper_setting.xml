<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yftech.libgallery.view.ClipImageView
        android:id="@+id/clip_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:failureImage="@mipmap/error_pic_bg"
        app:failureImageScaleType="fitCenter"
        app:placeholderImage="@drawable/progress_loading"/>
    <ImageView
        android:background="@color/transparent_4D"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/wall_card_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="80px"
        android:src="@mipmap/wallpaper_card_bg"
        android:scaleType="matrix"/>
    <TextView
        android:textSize="30px"
        android:textColor="@color/color_title_default"
        android:gravity="center"
        android:layout_gravity="bottom|right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="144px"
        android:text="@string/picture_clip"
        android:drawableLeft="@mipmap/icon_resize"
        android:drawablePadding="24px"
        android:layout_marginStart="100px"
        android:layout_marginEnd="353px"/>
    <LinearLayout
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52px"
        android:layout_marginEnd="218px">
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/wall_paper_set_bg_selector"
            android:layout_width="200px"
            android:layout_height="62px"
            android:text="@string/common_confirm_2"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/wall_paper_set_bg_close_selector"
            android:layout_width="200px"
            android:layout_height="62px"
            android:text="@string/common_cancel"
            android:layout_marginStart="100px"/>
    </LinearLayout>
</FrameLayout>
