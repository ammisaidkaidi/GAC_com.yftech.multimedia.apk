<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112px">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px">
        <ImageView
            android:id="@+id/iv_background"
            android:layout_width="match_parent"
            android:layout_height="88px"
            android:src="@mipmap/music_search_pic_songlist_light"
            android:scaleType="centerInside"/>
        <ImageView
            android:id="@+id/iv_station_favor_flag"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/radio_favorite_icon_on"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_station_icon"
            android:layout_width="88px"
            android:layout_height="88px"
            android:src="@mipmap/pic_list_tiny_default"
            android:scaleType="fitXY"
            android:layout_marginStart="92px"/>
        <ImageView
            android:id="@+id/iv_play_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_playing"
            android:layout_centerVertical="true"
            android:layout_marginStart="210px"
            android:layout_marginEnd="12px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="332px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="212px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="240px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="722px"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_service_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="1042px"/>
    </RelativeLayout>
</RelativeLayout>
