<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="82px">
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="wrap_content"
        android:layout_height="2px"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/tv_tag"/>
    <TextView
        android:textSize="22px"
        android:textColor="@color/colorB3FFFFFF"
        android:gravity="center"
        android:id="@+id/tv_tag"
        android:layout_width="148px"
        android:layout_height="wrap_content"
        android:text="@string/music_source_by_third_party_application"
        android:layout_centerInParent="true"/>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="wrap_content"
        android:layout_height="2px"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/tv_tag"/>
</RelativeLayout>
