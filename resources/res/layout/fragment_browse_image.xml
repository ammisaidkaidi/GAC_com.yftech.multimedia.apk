<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.media.common.ui.widget.MyActionBar
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40px"
        android:elevation="5px"
        app:showLine="false"
        app:title=""/>
    <com.media.common.ui.widget.zoomable.ZoomableDraweeView
        android:id="@+id/dv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:failureImage="@mipmap/error_pic_bg"
        app:failureImageScaleType="center"
        app:placeholderImage="@drawable/progress_loading"
        app:placeholderImageScaleType="center"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/control_bar"
        android:background="@mipmap/bottom_mask"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="145px">
        <include
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="67px"
            layout="@layout/image_browse_function_bar"/>
    </FrameLayout>
    <TextView
        android:textSize="36px"
        android:textColor="@color/colorB3FFFFFF"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_pic_play_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="481px"
        android:text="@string/picture_browse_play_error"/>
</FrameLayout>
