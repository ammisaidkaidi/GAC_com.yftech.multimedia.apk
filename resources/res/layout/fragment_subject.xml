<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lin_pic"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90px">
        <FrameLayout
            android:layout_width="230px"
            android:layout_height="230px">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@mipmap/pv_pic_error1"
                app:failureImage="@mipmap/pv_pic_error1"
                app:placeholderImageScaleType="centerInside"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_pic"
                android:layout_width="150px"
                android:layout_height="150px"
                android:indeterminateDrawable="@drawable/progress_loading"
                android:indeterminateDuration="200"
                android:elevation="5px"/>
        </FrameLayout>
        <TextView
            android:textSize="34px"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="49px"
            android:layout_marginTop="3px"
            android:text="@string/pic_name"
            android:paddingStart="5px"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_pic_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:text="0"
            android:paddingStart="5px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lin_video"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90px"
        android:layout_marginStart="24px">
        <FrameLayout
            android:layout_width="400px"
            android:layout_height="230px">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:backgroundImage="@mipmap/pv_vid_error1"
                app:failureImage="@mipmap/pv_vid_error1"
                app:placeholderImageScaleType="centerInside"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_video"
                android:layout_width="150px"
                android:layout_height="150px"
                android:indeterminateDrawable="@drawable/progress_loading"
                android:indeterminateDuration="200"
                android:elevation="5px"/>
        </FrameLayout>
        <TextView
            android:textSize="34px"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="49px"
            android:layout_marginTop="3px"
            android:text="@string/video_name"
            android:paddingStart="5px"/>
        <TextView
            android:textSize="26px"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_video_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:text="0"
            android:paddingStart="5px"/>
    </LinearLayout>
</LinearLayout>
