<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/radio_fm_pic_bg"
        android:scaleType="center"/>
    <com.media.common.ui.widget.CanvasView
        android:id="@+id/cv"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_fm"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="260dp"
        android:layoutDirection="ltr"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_am"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="260dp"
        android:layoutDirection="ltr"/>
    <RelativeLayout
        android:layout_width="181px"
        android:layout_height="71px"
        android:layout_marginTop="404px"
        android:layout_marginStart="910px">
        <View
            android:id="@+id/v_index_left_2"
            android:background="@drawable/radio_index"
            android:layout_width="4px"
            android:layout_height="44px"
            android:layout_alignBottom="@+id/v_index"
            android:layout_marginEnd="30px"
            android:layout_toStartOf="@+id/v_index_left_1"/>
        <View
            android:id="@+id/v_index_left_1"
            android:background="@drawable/radio_index"
            android:layout_width="4px"
            android:layout_height="59px"
            android:layout_alignBottom="@+id/v_index"
            android:layout_marginEnd="31px"
            android:layout_toStartOf="@+id/v_index"/>
        <View
            android:id="@+id/v_index"
            android:background="@color/colorFE0000"
            android:layout_width="4px"
            android:layout_height="71px"
            android:layout_centerInParent="true"/>
        <View
            android:id="@+id/v_index_right_1"
            android:background="@drawable/radio_index"
            android:layout_width="4px"
            android:layout_height="59px"
            android:layout_alignBottom="@+id/v_index"
            android:layout_marginStart="31px"
            android:layout_toEndOf="@+id/v_index"/>
        <View
            android:id="@+id/v_index_right_2"
            android:background="@drawable/radio_index"
            android:layout_width="4px"
            android:layout_height="44px"
            android:layout_alignBottom="@+id/v_index"
            android:layout_marginStart="31px"
            android:layout_toEndOf="@+id/v_index_right_1"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="586px"
        android:layout_height="130px"
        android:layout_marginTop="141px"
        android:layout_marginStart="714px">
        <ImageView
            android:id="@+id/iv_decrease"
            android:layout_width="80px"
            android:layout_height="80px"
            android:src="@drawable/fm_main_icon_decrease"
            android:layout_alignBottom="@+id/tv_channel"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="100px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_channel"
            android:layout_width="320px"
            android:layout_height="wrap_content"
            android:text="105.2"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto_regular"
            android:layout_toEndOf="@+id/iv_decrease"/>
        <TextView
            android:textSize="30px"
            android:textColor="@color/color66FFFFFF"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_channel_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14px"
            android:text="MHz"
            android:layout_alignBottom="@+id/iv_increase"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="14px"
            android:layout_toEndOf="@+id/tv_channel"/>
        <ImageView
            android:id="@+id/iv_increase"
            android:layout_width="80px"
            android:layout_height="80px"
            android:src="@drawable/fm_main_icon_increase"
            android:layout_alignBottom="@+id/tv_channel"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/layout_rds"
        android:layout_width="574px"
        android:layout_height="wrap_content"
        android:layout_marginTop="122px"
        android:layout_marginStart="714px">
        <LinearLayout
            android:id="@+id/layout_ta_tp_af"
            android:layout_width="wrap_content"
            android:layout_height="24px"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_ta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_ta"
                android:layout_weight="1"
                android:layout_marginStart="18px"
                android:layout_marginEnd="18px"/>
            <ImageView
                android:id="@+id/iv_tp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_tp"
                android:layout_weight="1"
                android:layout_marginStart="18px"
                android:layout_marginEnd="18px"/>
            <ImageView
                android:id="@+id/iv_af"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_af"
                android:layout_weight="1"
                android:layout_marginStart="18px"
                android:layout_marginEnd="18px"/>
        </LinearLayout>
        <TextView
            android:textSize="60px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_ps"
            android:layout_width="370px"
            android:layout_height="117px"
            android:layout_marginTop="20px"
            android:singleLine="true"
            android:layout_below="@+id/layout_ta_tp_af"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="819px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/colorB3FFFFFF"
            android:gravity="center"
            android:id="@+id/tv_rds_pty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="152px"
            android:layout_below="@+id/layout_ta_tp_af"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="43px"
        android:layout_alignParentBottom="true"
        layout="@layout/radio_control_bar"/>
</RelativeLayout>
