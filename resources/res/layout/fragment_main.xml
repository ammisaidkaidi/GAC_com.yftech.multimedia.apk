<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/pv_bg_error"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_tips_icon"
                android:layout_width="400px"
                android:layout_height="360px"
                android:layout_marginTop="82px"
                android:src="@mipmap/pv_error_usb_equipment"/>
            <TextView
                android:textSize="36px"
                android:textColor="@color/colorB3FFFFFF"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_tips_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8px"
                android:text="@string/usb_devices_error_tips_2"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/v_line"
        android:background="#1f2126"
        android:layout_width="match_parent"
        android:layout_height="3px"
        android:layout_alignBottom="@+id/selector"
        android:layout_marginEnd="20px"/>
    <com.media.common.ui.widget.MyTabSelector
        android:layout_gravity="top"
        android:id="@+id/selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/main"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/v_line"/>
</RelativeLayout>
