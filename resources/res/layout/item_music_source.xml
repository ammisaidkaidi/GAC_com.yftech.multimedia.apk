<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100px"
    android:paddingStart="16px"
    android:paddingEnd="16px">
    <ImageView
        android:id="@+id/iv_tag"
        android:layout_width="46px"
        android:layout_height="46px"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/music_bt_no_connect_size"
        android:textColor="@color/music_source_selector"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_centerVertical="true"
        android:textDirection="locale"
        android:layout_marginStart="10px"
        android:layout_marginEnd="10px"
        android:layout_toStartOf="@+id/iv_selector"
        android:layout_toEndOf="@+id/iv_tag"/>
    <ImageView
        android:id="@+id/iv_selector"
        android:background="@drawable/music_source_selector"
        android:layout_width="40px"
        android:layout_height="40px"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="invisible"
        android:layout_width="46px"
        android:layout_height="46px"
        android:indeterminateDrawable="@drawable/progress_loading"
        android:indeterminateDuration="200"
        android:layout_centerVertical="true"/>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
