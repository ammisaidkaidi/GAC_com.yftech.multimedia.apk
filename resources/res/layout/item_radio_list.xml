<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112px">
    <TextView
        android:textSize="32px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_station_index"
        android:layout_width="wrap_content"
        android:layout_height="88px"
        android:minWidth="40px"
        android:singleLine="true"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="88px"
        android:layout_marginTop="24px"
        android:layout_marginStart="88px">
        <ImageView
            android:id="@+id/iv_play"
            android:background="@drawable/music_playing"
            android:layout_width="40px"
            android:layout_height="40px"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18px"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="332px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto_regular"
            android:layout_toEndOf="@+id/iv_play"/>
        <LinearLayout
            android:id="@+id/layout_ta_tp_af"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="36px"
            android:layout_toEndOf="@+id/tv_station_name">
            <ImageView
                android:id="@+id/iv_ta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_ta"
                android:layout_weight="1"
                android:layout_marginStart="8px"
                android:layout_marginEnd="8px"/>
            <ImageView
                android:id="@+id/iv_tp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_tp"
                android:layout_weight="1"
                android:layout_marginStart="8px"
                android:layout_marginEnd="8px"/>
            <ImageView
                android:id="@+id/iv_af"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/rds_label_af"
                android:layout_weight="1"
                android:layout_marginStart="8px"
                android:layout_marginEnd="8px"/>
        </LinearLayout>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_station_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="210px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="938px"/>
    </RelativeLayout>
</RelativeLayout>
