<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="15px"
    android:layout_width="match_parent"
    android:layout_height="130px"
    android:paddingEnd="15px">
    <TextView
        android:textSize="30px"
        android:textColor="@color/color80FFFFFF"
        android:gravity="center"
        android:id="@+id/tv_order"
        android:layout_width="wrap_content"
        android:layout_height="40px"
        android:minWidth="46px"
        android:layout_marginEnd="4px"/>
    <ImageView
        android:id="@+id/iv_playing"
        android:background="@drawable/music_playing_new"
        android:visibility="invisible"
        android:layout_width="46px"
        android:layout_height="46px"
        android:scaleType="centerInside"
        android:paddingStart="15px"
        android:paddingEnd="15px"/>
    <com.media.common.ui.widget.WordsLimitTextView
        android:id="@+id/tv_name"
        android:background="@color/transparent"
        android:layout_width="350px"
        android:layout_height="46px"
        android:layout_marginStart="5px"
        android:layout_toEndOf="@+id/tv_order"
        app:words_limit_count="20"
        app:words_limit_ellipsizeStart="20"
        app:words_limit_text="@string/common_unknown"
        app:words_limit_textSize="32px"/>
    <com.media.common.ui.widget.WordsLimitTextView
        android:id="@+id/tv_artist"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="40px"
        android:layout_marginBottom="20px"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="75px"
        android:layout_toStartOf="@+id/tv_duration"
        android:layout_alignStart="@+id/tv_name"
        app:words_limit_count="20"
        app:words_limit_ellipsizeStart="20"
        app:words_limit_text="@string/common_unknown"
        app:words_limit_textColor="@color/color66FFFFFF"
        app:words_limit_textSize="28px"/>
    <TextView
        android:textSize="26px"
        android:textColor="@color/color80FFFFFF"
        android:gravity="center_vertical"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="40px"
        android:text="00:00"
        android:layout_alignBottom="@+id/tv_artist"
        android:layout_alignParentEnd="true"/>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="58px"/>
</RelativeLayout>
