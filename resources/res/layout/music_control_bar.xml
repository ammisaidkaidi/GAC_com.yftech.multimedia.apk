<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="30px">
    <ImageView
        android:id="@+id/iv_last"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/music_main_icon_last_song"/>
    <ImageView
        android:id="@+id/iv_music_play"
        android:layout_width="80px"
        android:layout_height="80px"
        android:src="@drawable/music_main_icon_pause"
        android:layout_marginStart="74px"
        android:layout_marginEnd="74px"/>
    <ImageView
        android:id="@+id/iv_next"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/music_main_icon_next_song"/>
    <ImageView
        android:id="@+id/iv_func_1"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/music_main_icon_song_list"
        android:layout_marginStart="92px"/>
    <ImageView
        android:id="@+id/iv_func_2"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/music_main_icon_random"
        android:layout_marginStart="80px"
        android:layout_marginEnd="80px"/>
    <ImageView
        android:id="@+id/iv_func_3"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/music_main_icon_search"/>
</LinearLayout>
