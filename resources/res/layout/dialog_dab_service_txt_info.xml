<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_rootview"
    android:background="@drawable/pic_dialog_bg"
    android:padding="22px"
    android:layout_width="1078px"
    android:layout_height="678px">
    <TextView
        android:textSize="36px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38px"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:scrollbarThumbVertical="@mipmap/pic_scroll_bar"
        android:scrollbarStyle="outsideOverlay"
        android:textSize="32px"
        android:textColor="@color/colorB3FFFFFF"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16px"
        android:maxHeight="412px"
        android:layout_below="@+id/tv_title"
        android:paddingEnd="44px"
        android:layout_marginStart="60px"
        android:layout_marginEnd="10px"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/color26CCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_above="@+id/tv_control"/>
    <TextView
        android:textSize="32px"
        android:textColor="@color/colorFFFFFF"
        android:gravity="center"
        android:id="@+id/tv_control"
        android:background="@drawable/selector_dialog_one_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="100px"
        android:text="@string/back"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
