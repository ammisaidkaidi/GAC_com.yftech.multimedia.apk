<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="88px"
        android:layout_marginTop="24px">
        <ImageView
            android:id="@+id/iv_epg_status"
            android:visibility="visible"
            android:layout_width="68px"
            android:layout_height="wrap_content"
            android:src="@mipmap/btn_epg_reserve"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_epg_icon"
            android:layout_width="88px"
            android:layout_height="88px"
            android:src="@mipmap/pic_list_tiny_default"
            android:scaleType="fitXY"
            android:layout_marginStart="31px"
            android:layout_toEndOf="@+id/iv_epg_status"/>
        <ImageView
            android:id="@+id/iv_play_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_playing"
            android:layout_centerVertical="true"
            android:layout_marginStart="30px"
            android:layout_marginEnd="6px"
            android:layout_toEndOf="@+id/iv_epg_icon"/>
        <TextView
            android:textSize="32px"
            android:textColor="@color/colorFFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_epg_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="332px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="32px"
            android:layout_toEndOf="@+id/iv_epg_icon"/>
        <TextView
            android:textSize="28px"
            android:textColor="@color/colorB3FFFFFF"
            android:ellipsize="end"
            android:id="@+id/tv_epg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="278px"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="862px"
            android:layout_toEndOf="@+id/iv_epg_icon"/>
    </RelativeLayout>
</RelativeLayout>
