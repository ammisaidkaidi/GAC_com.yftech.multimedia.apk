<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_like"
        android:layout_centerVertical="true"
        android:layout_marginStart="338px"/>
    <ImageView
        android:id="@+id/iv_like_list"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_like_list"
        android:layout_centerVertical="true"
        android:layout_marginStart="90px"
        android:layout_toEndOf="@+id/iv_like"/>
    <ImageView
        android:id="@+id/iv_last"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_last_song"
        android:layout_centerVertical="true"
        android:layout_marginStart="284px"
        android:layout_toEndOf="@+id/iv_like_list"/>
    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="80px"
        android:layout_height="80px"
        android:src="@drawable/fm_main_icon_playing"
        android:layout_marginStart="86px"
        android:layout_toEndOf="@+id/iv_last"/>
    <ImageView
        android:id="@+id/iv_next"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_next_song"
        android:layout_centerVertical="true"
        android:layout_marginStart="86px"
        android:layout_toEndOf="@+id/iv_play"/>
    <ImageView
        android:id="@+id/iv_search"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_search"
        android:layout_centerVertical="true"
        android:layout_marginStart="224px"
        android:layout_toEndOf="@+id/iv_next"/>
    <ImageView
        android:id="@+id/iv_settings"
        android:layout_width="54px"
        android:layout_height="54px"
        android:src="@drawable/fm_main_icon_settings"
        android:layout_centerVertical="true"
        android:layout_marginStart="90px"
        android:layout_toEndOf="@+id/iv_search"/>
    <ImageView
        android:id="@+id/iv_epg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dab_main_icon_epg"
        android:layout_centerVertical="true"
        android:layout_marginStart="96px"
        android:layout_toEndOf="@+id/iv_settings"/>
</RelativeLayout>
