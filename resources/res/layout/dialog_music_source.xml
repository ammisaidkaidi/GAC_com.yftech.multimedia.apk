<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@mipmap/music_cardlist_pic_bg"
    android:padding="22px"
    android:layout_width="580px"
    android:layout_height="696px">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90px"
        android:layout_marginBottom="0px">
        <TextView
            android:textSize="36px"
            android:textStyle="bold"
            android:textColor="@color/colorFFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_source_dialog_title"
            android:layout_centerVertical="true"
            android:layout_marginStart="20px"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="54px"
            android:layout_height="54px"
            android:src="@drawable/btn_close_selector"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15px"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_alignParentBottom="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:paddingBottom="15px"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
</LinearLayout>
