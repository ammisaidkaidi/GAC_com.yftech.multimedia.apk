<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="15px"
    android:layout_width="match_parent"
    android:layout_height="130px"
    android:paddingEnd="15px">
    <com.yftech.car.widget.media.view.PlayAnimation
        android:textSize="30sp"
        android:textColor="@color/color80FFFFFF"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/tv_order"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="46dp"
        android:layout_marginStart="5px"
        android:layout_marginEnd="5px"
        app:no_play_is_number="true"
        app:play_drawable="@drawable/music_playing_new"/>
    <com.yftech.car.widget.media.text.MediaFileTextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="360px"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/tv_order"
        app:search_size_text_color="@color/colorFFFFEF57"
        app:title_position="1"
        app:title_text_color="@color/colorFFFFFF"
        app:title_text_selected_color="@color/colorDD9D09"
        app:title_text_size="32px"
        app:title_text_unknown="@string/common_unknown"/>
    <com.yftech.car.widget.media.text.MediaFileTextView
        android:ellipsize="end"
        android:id="@+id/tv_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20px"
        android:lines="1"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="75px"
        android:layout_toStartOf="@+id/tv_duration"
        android:layout_alignStart="@+id/tv_name"
        app:artist_position="1"
        app:artist_text_color="@color/color66FFFFFF"
        app:artist_text_selected_color="@color/colorDD9D09"
        app:artist_text_size="28px"
        app:artist_text_unknown="@string/common_unknown"/>
    <com.yftech.car.widget.media.text.MediaFileTextView
        android:textSize="26px"
        android:textColor="@color/color80FFFFFF"
        android:gravity="center_vertical"
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="40px"
        android:text="00:00"
        android:layout_alignBottom="@+id/tv_artist"
        android:layout_alignParentEnd="true"
        app:duration_file_SimpleDateFormat_pattern="mm:ss"
        app:duration_file_position="1"
        app:duration_file_text_color="@color/color80FFFFFF"
        app:duration_file_text_selected_color="@color/colorB3DD9D09"/>
    <View
        android:background="@color/color1ACCDDFF"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="58px"/>
</RelativeLayout>
