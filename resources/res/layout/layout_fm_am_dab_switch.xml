<?xml version="1.0" encoding="utf-8"?>
<com.media.common.ui.widget.FlowRadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rg"
    android:layout_width="318px"
    android:layout_height="72px"
    android:layoutDirection="ltr">
    <FrameLayout
        android:background="@mipmap/radio_fm_am_dab_switch_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/v_selected"
            android:background="@mipmap/radio_fm_am_dab_switch_btn"
            android:layout_width="106px"
            android:layout_height="match_parent"/>
        <RadioButton
            android:textSize="24px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/rb_fm"
            android:layout_width="106px"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:text="FM"/>
        <RadioButton
            android:textSize="24px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/rb_am"
            android:layout_width="106px"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="AM"/>
        <RadioButton
            android:textSize="24px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/rb_dab"
            android:layout_width="106px"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="DAB"/>
    </FrameLayout>
</com.media.common.ui.widget.FlowRadioGroup>
