<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingBottom="78px"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.media.common.ui.widget.MyActionBar
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40px"
        android:elevation="5px"
        app:showLine="false"
        app:title=""/>
    <com.media.common.ui.widget.zoomable.ZoomableDraweeView
        android:id="@+id/dv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:failureImage="@mipmap/pv_error_pic"
        app:failureImageScaleType="fitCenter"
        app:placeholderImage="@drawable/progress_loading"/>
    <include
        android:layout_gravity="bottom"
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40px"
        layout="@layout/image_browse_function_bar"/>
</FrameLayout>
