<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/pic_bg2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fragment_egp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80px"
        android:layout_marginBottom="80px"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/tab_epg"
        android:layout_width="wrap_content"
        android:layout_height="80px"
        android:layout_marginStart="180px"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:textSize="28px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:id="@+id/rb_epg_all_list"
            android:background="@drawable/ic_tab_s"
            android:layout_width="350px"
            android:layout_height="match_parent"
            android:checked="false"
            android:button="@null"
            android:text="@string/dab_tab_epg_all_list"
            android:includeFontPadding="false"/>
        <RadioButton
            android:textSize="28px"
            android:textColor="@color/colorFFFFFF"
            android:gravity="center"
            android:id="@+id/rb_epg_subscribed_list"
            android:background="@drawable/ic_tab_s"
            android:layout_width="350px"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/dab_tab_epg_subscribed_list"
            android:includeFontPadding="false"/>
    </RadioGroup>
</RelativeLayout>
